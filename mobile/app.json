{
  "expo": {
    "name": "Miamoire",
    "slug": "food",
    "scheme": "food",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theo.food",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres des produits que vous ajoutez à votre stock."
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      }
    },
    "android": {
      "package": "com.theo.food",
      "versionCode": 15,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#123B35"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 122,
          "resizeMode": "contain",
          "backgroundColor": "#123B35"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#123B35"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les codes-barres des produits que vous ajoutez à votre stock."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f19c1df3-dd7a-4529-8331-7355a7697eee"
      }
    }
  }
}
