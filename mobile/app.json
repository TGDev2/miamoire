{
  "expo": {
    "name": "Food",
    "slug": "food",
    "scheme": "food",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theo.food",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres des produits que vous ajoutez à votre stock."
      }
    },
    "android": {
      "package": "com.theo.food",
      "adaptiveIcon": {
        "backgroundColor": "#2F6B4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les codes-barres des produits que vous ajoutez à votre stock."
        }
      ]
    ]
  }
}
