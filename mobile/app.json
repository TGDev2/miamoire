{
  "expo": {
    "name": "Food",
    "slug": "food",
    "scheme": "food",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theo.food",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner les codes-barres des produits que vous ajoutez à votre stock."
      }
    },
    "android": {
      "package": "com.theo.food",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#2F6B4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9372C"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les codes-barres des produits que vous ajoutez à votre stock."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f19c1df3-dd7a-4529-8331-7355a7697eee"
      }
    }
  }
}
